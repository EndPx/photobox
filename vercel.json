{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "rewrites": [
    {"source": "/kasir", "destination": "/cashier.html"},
    {"source": "/api/:route((?!photobox$).+)", "destination": "/api/photobox?photoboxRoute=:route"}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "no-referrer"},
        {"key": "Permissions-Policy", "value": "camera=(self), microphone=()"},
        {"key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data: blob: https://api.midtrans.com https://api.sandbox.midtrans.com; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"}
      ]
    },
    {
      "source": "/sw.js",
      "headers": [{"key": "Cache-Control", "value": "no-cache"}]
    }
  ]
}
